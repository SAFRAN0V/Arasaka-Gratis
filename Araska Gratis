    local medalRaceActive = false
    local medalRaceCycleRunning = false
    local medalRaceConfig = {
        LobbyWait = 10.1,
        Primeiro = Vector3.new(-13369.75, 10.12, 0),
        Peso = Vector3.new(-13802.77, 8.10, 0),
        QuedaBraco = Vector3.new(-14539, 8, -4156),
