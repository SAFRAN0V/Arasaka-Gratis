--==================================================
local CoreMemoryModule = {
    Name = "\067\111\114\101\077\101\109\111\114\121"
}

function CoreMemoryModule:Start()
    if Core:IsWorkerRunning("\067\111\114\101\077\101\109\111\114\121") then
        return true
    end

    return Core:StartWorker("\067\111\114\101\077\101\109\111\114\121", function(isAlive)
        while isAlive() do
            -- Espera fracionada para que STOP não precise aguardar 30s.
