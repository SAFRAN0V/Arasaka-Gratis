        local function postFreeBossHeartbeat(bossName)
            local req = findFreeHttpRequest()
            local body = HttpService:JSONEncode({
                boss = bossName,
                placeId = tostring(game.PlaceId),
            })

            if req then
                local ok, response = pcall(function()
                    return req({
                        Url = FREE_BOSS_API .. "\047\097\112\105\047\102\114\101\101\045\098\111\115\115\045\104\101\097\114\116\098\101\097\116",
                        Method = "\080\079\083\084",
