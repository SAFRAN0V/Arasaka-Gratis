                pcall(function()
                    event:FireServer("punch", "leftHand")
                    event:FireServer("punch", "rightHand")
                end)
            end
            local elapsed = os.clock() - startedAt
            if not evaluationDone and elapsed >= EVALUATE_AFTER then
                evaluationDone = true
                local healthDrop = math.max(0, startHealth - targetHum.Health)
                local dropRatio = healthDrop / math.max(startHealth, 1)
                if dropRatio < MIN_HEALTH_DROP_RATIO then
                    killTargetCooldownUntil[target.UserId] = os.clock() + SKIP_COOLDOWN
                    return false, "too_strong"
                end
            end
            if elapsed >= MAX_TARGET_TIME then
                killTargetCooldownUntil[target.UserId] = os.clock() + SKIP_COOLDOWN
                return false, "timeout"
            end
            task.wait(ATTACK_INTERVAL)
        end
        return false, "stopped"
    end
