local start=os.clock()
local function clamp(n) return math.clamp(n,0,1) end
local function animateFrame()
    if not alive then return end
    local t=os.clock()-start
    local p=clamp(t/CONFIG.Duration)
    local s=p*16
    local size=root.AbsoluteSize
    scale.Scale=math.max(.25,math.min(size.X/880,size.Y/720))
    local transition=clamp((s-3.4)/1.1)
    center.Visible=true
    status.TextSize=math.clamp(size.Y*.013,10,30)
    halo.BackgroundTransparency=clamp(.96-.025*math.sin(t*3)+transition*.04)
    for i,ring in ipairs(rings) do
        local diameter=ring[3]*(1+.025*math.sin(t*4+i)+transition*1.7)
        ring[1].Size=UDim2.fromOffset(diameter,diameter)
        ring[2].Transparency=clamp((i==2 and .05 or .65)+transition)
    end
    for index,part in ipairs(particles) do
        local a=part.angle+t*part.speed*(1-transition*.65)
        local burst=math.sin(clamp((s-3.3)/2)*math.pi)*170
        local r=part.radius+math.sin(t*3+part.seed)*18+burst
        local x,y=math.cos(a)*r,math.sin(a)*r*.84
        if s>5 then
            x=math.cos(a)*(r+65)
            y=math.sin(a)*(r+65)*.84
        end
        part.dot.Position=UDim2.new(.5,x,.5,y)
        part.dot.Rotation=math.deg(a)+t*70
        part.dot.BackgroundTransparency=clamp(.08+.48*(1+math.sin(t*5+part.seed))/2)
        if index<=#trails then
            local trail=trails[index]
            trail.Position=part.dot.Position
            trail.Size=UDim2.fromOffset(10+part.size*3+burst*.12,math.max(1,part.size*.23))
            trail.Rotation=math.deg(a)+90
            trail.BackgroundTransparency=.5+part.dot.BackgroundTransparency*.4
        end
    end
    for i,wave in ipairs(waves) do
        local phase=(t*.36+i/4)%1
        local diameter=220+phase*780
        wave[1].Size=UDim2.fromOffset(diameter,diameter)
        wave[2].Transparency=clamp(.45+phase*.55)
    end
    for i,line in ipairs(arcs) do
        local group=math.floor((i-1)/24)
        local segment=(i-1)%24
        local base=t*(group%2==0 and .5 or -.4)+group*2.1
        local a=base+segment*.045
        local b=a+.045
        local radius=127+group*13+math.sin(t*18+segment*2.7+group)*5
        local nextRadius=127+group*13+math.sin(t*18+(segment+1)*2.7+group)*5
        local x1,y1=math.cos(a)*radius,math.sin(a)*radius
        local x2,y2=math.cos(b)*nextRadius,math.sin(b)*nextRadius
        line.Position=UDim2.new(.5,(x1+x2)/2,.5,(y1+y2)/2)
        line.Size=UDim2.fromOffset(math.sqrt((x2-x1)^2+(y2-y1)^2)+1,1.5)
        line.Rotation=math.deg(math.atan2(y2-y1,x2-x1))
        line.BackgroundTransparency=clamp(.1+transition)
    end
    local show=clamp((s-4.1)/1.1)
    viewport.ImageTransparency=1-show
    tv.Visible=s>3.3
    diagnostic.Visible=s>3.3
    chipViewport.Visible=s>3.3
    local tvReveal=clamp((s-3.3)/.55)
    tv.Size=UDim2.fromScale(.84,.68*math.max(.008,tvReveal))
    local sentence=""
    local talking=false
    for _,entry in ipairs(dialogue) do
        if s>=entry[1] and s<entry[2] then
            local count=math.floor((s-entry[1])*CONFIG.Duration/16*32)
            sentence=string.sub(entry[3],1,count)
            talking=true
            break
        end
    end
    speech.Text=sentence
    local nod=talking and math.sin(t*2.8)*.035 or math.sin(t*.8)*.018
    headRig:PivotTo(CFrame.new(0,1.88+math.sin(t*1.6)*.018,0)*CFrame.Angles(nod,math.sin(t*.55)*.09,math.sin(t*.6)*.015))
    local mouthOpen=talking and (.035+math.abs(math.sin(t*12))*math.abs(math.sin(t*5.7))*.115) or .035
    mouth.Size=Vector3.new(.46,mouthOpen,.025)
    local blink=t%4.3>4.13
    for _,lid in ipairs(lids) do lid.Transparency=blink and 0 or 1 end
    local gesture=math.sin(clamp((s-6.4)/2.4)*math.pi)
    local order=math.sin(clamp((s-13.1)/1.7)*math.pi)
    for _,arm in ipairs(arms) do
        local raise=arm.side==1 and gesture or order*.8
        arm.model:PivotTo(CFrame.new(arm.side*1.43,.75,0)*CFrame.Angles(-.23-raise*.9,0,arm.side*(.11+raise*.2)))
    end
    local aspect=math.max(.2,viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y))
    local visibleHeight=math.max(5.1-clamp((s-5)/8)*.5,4.4/aspect)
    local distance=visibleHeight/(2*math.tan(math.rad(camera.FieldOfView/2)))
    local focus=Vector3.new(0,1.22,0)
    camera.CFrame=CFrame.lookAt(focus+Vector3.new(math.sin(t*.3)*.2,.04,-distance),focus)
    chip:PivotTo(CFrame.Angles(.13,math.sin(t*.6)*.65,t*.12))
    local interference=(s>3.3 and s<4.3) or (s>10.75 and s<11.15) or (s>14.2)
    local gate=interference and math.sin(t*47)>.15
    for i,line in ipairs(glitches) do
        line.BackgroundTransparency=gate and (.55+(i%3)*.12) or 1
        line.Position=UDim2.fromScale(math.sin(t*13+i)*.07,(i*.117+t*.3)%1)
        line.Size=UDim2.fromScale(.5+((i*7)%5)*.1,.002+(i%3)*.005)
    end
    viewport.Position=UDim2.fromScale(gate and math.sin(t*71)*.004 or 0,0)
    viewport.ImageColor3=gate and Color3.fromRGB(160,240,255) or Color3.fromRGB(223,234,244)
    scan.Position=UDim2.fromScale(0,(t*.18)%1-.1)
    live.Text=gate and "SIGNAL LOST" or "LIVE  /  TOKYO"
    diagnostic.Text=s<11 and "RELIC 2.0  //  ENGRAM DETECTED" or s<14.2 and "RELIC 2.0  //  TRANSFER IN PROGRESS" or "RELIC 2.0  //  PERSONALITY CONSTRUCT ONLINE"
    for i,beam in ipairs(beams) do
        beam.BackgroundTransparency=1-show*(.035+.075*(1+math.sin(t*2+i))/2)
        beam.Position=UDim2.fromScale(i/19+math.sin(t*.7+i)*.025,.5+math.sin(t+i)*.08)
    end
    root.BackgroundColor3=Color3.fromRGB(3+math.floor(show*22),3,8+math.floor(show*8))
    local pulse=math.exp(-((s-3.8)/.13)^2)*.85+math.exp(-((s-7.2)/.12)^2)*.32
    flash.BackgroundColor3=s<5 and white or red
    flash.BackgroundTransparency=1-clamp(pulse)
    local textFade=clamp((s-3.5)/1.2)
    title.TextTransparency=1-textFade
    subtitle.TextTransparency=1-textFade
    fill.Size=UDim2.fromScale(p,1)
    local message=s<4 and "LOCALIZANDO SINAL" or s<9 and "DECODIFICANDO ENGRAMA" or s<14 and "SINCRONIZANDO RELIC" or "CONSTRUTO ATIVO"
