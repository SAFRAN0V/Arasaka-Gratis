    local function MedalNormalizeImageId(value)
        if typeof(value) == "number" then
            if value > 0 then return "rbxassetid://" .. tostring(math.floor(value)) end
            return nil
        end
        if typeof(value) ~= "string" then return nil end
        value = value:gsub("^%s+", ""):gsub("%s+$", "")
        if value == "" then return nil end
        if value:match("^%d+$") then return "rbxassetid://" .. value end
        if value:match("^rbxassetid://") or value:match("^https?://") then return value end
        return nil
    end

