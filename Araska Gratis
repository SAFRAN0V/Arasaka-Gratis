            while elapsed < 30 and isAlive() do
                task.wait(0.25)
                elapsed += 0.25
            end

            if not isAlive() then
                break
            end

            pcall(function()
                collectgarbage("\099\111\117\110\116")
            end)
        end
    end)
end

