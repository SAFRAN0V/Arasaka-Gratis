            while isAlive() and Kill.State.mode do
                local found = false
                local attackedSomeone = false
                for _, target in ipairs(Players:GetPlayers()) do
                    if not isAlive() or not Kill.State.mode then break end
                    if shouldKillTarget(target) then
                        found = true
                        local cooldownUntil = killTargetCooldownUntil[target.UserId]
                        if not cooldownUntil or os.clock() >= cooldownUntil then
                            attackedSomeone = true
                            killStatus.Text = "ATACANDO // @" .. target.Name
                            local _, reason = attackKillTarget(target)
                            if reason == "too_strong" then
                                killStatus.Text = "PULANDO FORTE // @" .. target.Name .. " // 10s"
                            elseif reason == "timeout" then
                                killStatus.Text = "PULANDO LENTO // @" .. target.Name .. " // 10s"
                            elseif reason == "killed" then
                                killStatus.Text = "ELIMINADO // @" .. target.Name
                            end
                            task.wait(0.05)
                        end
                    end
                end
                if not Kill.State.mode then
                    killStatus.Text = "STATUS // AGUARDANDO"
                elseif not found then
                    killStatus.Text = "STATUS // NENHUM ALVO VÁLIDO"
                    task.wait(0.25)
                elseif not attackedSomeone then
                    killStatus.Text = "STATUS // ALVOS EM COOLDOWN"
                    task.wait(0.25)
                else
                    task.wait(0.03)
                end
            end
            if killStatus and killStatus.Parent then killStatus.Text = "STATUS // AGUARDANDO" end
        end)
