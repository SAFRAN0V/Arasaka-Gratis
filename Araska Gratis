            end
            if targetHum.Health <= 0 then
                killTargetCooldownUntil[target.UserId] = nil
                return true, "killed"
            end
            if startHealth == nil then startHealth = math.max(targetHum.Health, 1) end
            pcall(function()
                myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end)
            local tool = getPunchToolForKill()
            if tool then pcall(function() tool:Activate() end) end
            local event = getMuscleEvent()
