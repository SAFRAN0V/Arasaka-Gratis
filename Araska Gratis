    local killTargetCooldownUntil = {}
    local function attackKillTarget(target)
        if not Kill.State.mode or not Core:IsAlive() or not target then
            return false, "invalid"
        end
        local cooldownUntil = killTargetCooldownUntil[target.UserId]
        if cooldownUntil and os.clock() < cooldownUntil then
            return false, "cooldown"
        end
        local ATTACK_INTERVAL = 0.08
        local EVALUATE_AFTER = 2.0
        local MAX_TARGET_TIME = 8.0
        local SKIP_COOLDOWN = 10.0
        local MIN_HEALTH_DROP_RATIO = 0.01
        local startedAt = os.clock()
        local evaluationDone = false
        local startHealth = nil
        while Kill.State.mode and Core:IsAlive() do
            if not target.Parent then return true, "left" end
            local myChar = player.Character
            local targetChar = target.Character
            if not myChar or not targetChar then return true, "respawn" end
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if not myHum or myHum.Health <= 0 or not targetHum or not myRoot or not targetRoot then
