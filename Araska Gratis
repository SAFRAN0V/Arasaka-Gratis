function Core:PruneDisconnectedConnections()
    local removed = 0
    for owner, connections in pairs(self.Connections) do
        for i = #connections, 1, -1 do
            local conn = connections[i]
            local ok, connected = pcall(function()
                return conn ~= nil and conn.Connected
            end)
            if not ok or connected ~= true then
                table.remove(connections, i)
                removed += 1
            end
        end
        if #connections == 0 then
            self.Connections[owner] = nil
        end
    end
    return removed
end
function Core:MemoryHousekeeping()
    if not self:IsAlive() then return end
    local pruned = self:PruneDisconnectedConnections()
    local pgui = player and player:FindFirstChildOfClass("PlayerGui")
    local nGui = pgui and pgui:FindFirstChild("ArasakaNotificationGui")
    local holder = nGui and nGui:FindFirstChild("Holder")
    local expired = 0
    if holder then
        local now = os.clock()
        for _, child in ipairs(holder:GetChildren()) do
            if child.Name == "Notificacao" and child:IsA("Frame") then
                local expireAt = child:GetAttribute("ArasakaExpireAt")
                if type(expireAt) == "number" and now > expireAt then
                    child:Destroy()
                    expired += 1
                end
            end
        end
    end
    local stats = self.MemoryHousekeepingStats
    if not stats then
        stats = {}
        self.MemoryHousekeepingStats = stats
    end
    stats.ranAt = os.clock()
    stats.disconnectedRefs = pruned
    stats.expiredNotifications = expired
    stats.connectionCount = self:GetConnectionCount()
    local statsService = game:GetService("Stats")
    local function readRobloxMB(callback)
        local ok, value = pcall(callback)
        return ok and type(value) == "number" and value or nil
    end
    local totalMB = readRobloxMB(function() return statsService:GetTotalMemoryUsageMb() end)
    local heapMB = readRobloxMB(function()
        return statsService:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.LuaHeap)
    end)
    local instancesMB = readRobloxMB(function()
        return statsService:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Instances)
    end)
    local signalsMB = readRobloxMB(function()
        return statsService:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Signals)
    end)
    local countWorkers = 0
    for _, worker in pairs(self.Workers) do
        if worker.running then countWorkers += 1 end
    end
    stats.totalMB, stats.luaHeapMB = totalMB, heapMB
    stats.instancesMB, stats.signalsMB = instancesMB, signalsMB
    stats.workerCount = countWorkers
    stats.shopRebuilds = self.MemAuditCounters.shopRebuilds
    if totalMB and not stats.baselineMB then stats.baselineMB = totalMB end
    stats.deltaMB = totalMB and stats.baselineMB and (totalMB - stats.baselineMB) or nil
    print(string.format(
        "[ARASAKA][RAM] Roblox=%.1fMB | LuaHeap=%s | Instances=%s | Signals=%s | Δ=%s | workers=%d | conns=%d | shopRebuilds=%d",
        totalMB or -1,
        heapMB and string.format("%.1f", heapMB) or "N/A",
        instancesMB and string.format("%.1f", instancesMB) or "N/A",
        signalsMB and string.format("%.1f", signalsMB) or "N/A",
        stats.deltaMB and string.format("%+.1fMB", stats.deltaMB) or "N/A",
        countWorkers, stats.connectionCount, stats.shopRebuilds
    ))
end
