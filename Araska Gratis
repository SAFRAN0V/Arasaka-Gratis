    local function getPromptWorldPosition(prompt)
        if not prompt or not prompt.Parent then return nil end
        local parent = prompt.Parent
        if parent:IsA("\065\116\116\097\099\104\109\101\110\116") then
            local bp = parent.Parent
            return (bp and bp:IsA("\066\097\115\101\080\097\114\116")) and bp.Position or nil
        end
        return parent:IsA("\066\097\115\101\080\097\114\116") and parent.Position or nil
    end

    local function findNearestFarmPrompt(position, radius)
        radius = radius or 22
        local nearest, best = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("\080\114\111\120\105\109\105\116\121\080\114\111\109\112\116") then
                local pos = getPromptWorldPosition(obj)
                if pos then
                    local dist = (pos - position).Magnitude
                    if dist <= radius and dist < best then
                        nearest, best = obj, dist
                    end
                end
            end
        end
        return nearest
    end

