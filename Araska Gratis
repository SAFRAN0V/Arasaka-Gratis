    titleBar.Active = true
    local dragActive = false
    local dragStart = nil
    local frameStart = nil
    local activeTouch = nil
    local function clampMainWindow()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local viewport = cam.ViewportSize
        local absSize = frame.AbsoluteSize
        local halfX = math.max(24, absSize.X * 0.5)
        local halfY = math.max(24, absSize.Y * 0.5)
        local currentCenterX = frame.AbsolutePosition.X + absSize.X * 0.5
        local currentCenterY = frame.AbsolutePosition.Y + absSize.Y * 0.5
        local x = math.clamp(currentCenterX, halfX, math.max(halfX, viewport.X - halfX))
        local y = math.clamp(currentCenterY, halfY, math.max(halfY, viewport.Y - halfY))
        frame.Position = UDim2.fromOffset(x, y)
    end
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragActive = true
        activeTouch = input.UserInputType == Enum.UserInputType.Touch and input or nil
        dragStart = input.Position
        frameStart = frame.Position
    end
    local function updateDrag(input)
        if not dragActive or not Core:IsAlive() or not screenGui.Parent or not dragStart or not frameStart then return end
        if activeTouch and input ~= activeTouch then return end
        if not activeTouch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            frameStart.X.Scale, frameStart.X.Offset + delta.X,
            frameStart.Y.Scale, frameStart.Y.Offset + delta.Y
        )
        clampMainWindow()
    end
    local function endDrag(input)
        if not dragActive then return end
        if activeTouch and input ~= activeTouch then return end
        dragActive, activeTouch, dragStart, frameStart = false, nil, nil, nil
    end
    Core:AddCleanup("UI", function()
        dragActive, activeTouch, dragStart, frameStart = false, nil, nil, nil
    end)
