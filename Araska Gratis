    local medalRateLimitedUntil = 0

    local function MedalIsRateLimited()
        return os.clock() < medalRateLimitedUntil
    end

    local function MedalMarkRateLimited(seconds)
        seconds = tonumber(seconds) or 8
        medalRateLimitedUntil = math.max(medalRateLimitedUntil, os.clock() + seconds)
    end

    local function MedalGetShopState()
        if not medalShopRemote or not medalShopRemote:IsA("RemoteFunction") then
            return nil, "Remote medalShopRemote não encontrado."
        end
        if MedalIsRateLimited() then
            local left = math.ceil(medalRateLimitedUntil - os.clock())
            return nil, "rateLimited (aguarde " .. tostring(left) .. "s)"
        end
        local ok, response = pcall(function()
            return medalShopRemote:InvokeServer("GetState")
        end)
        if not ok then return nil, tostring(response) end
        if type(response) ~= "table" or response.Ok == false then
            local reason = type(response) == "table" and response.Reason or nil
            if reason == "notInGym" then
                return nil, "entre no círculo da Medal Shop; o servidor recusou fora da área (notInGym)."
            end
            if reason == "rateLimited" or reason == "RateLimited" or tostring(reason or ""):lower():find("ratelimit", 1, true) then
                MedalMarkRateLimited(10)
                return nil, "rateLimited"
            end
            return nil, tostring(reason or "estado da loja inválido.")
        end
        return response, nil
    end

    local function MedalRefreshShop()
        if medalShopBusy then return false end
        medalShopVisible = true
        medalOffersHeader.Visible = true
        medalOffersHeader.Size = UDim2.new(1, -6, 0, 25)
        medalShopBusy = true
        MedalSetShopStatus("consultando ofertas...", Color3.fromRGB(170, 170, 170))
        local state, err = MedalGetShopState()
        if state then
            medalCurrentState = state
            MedalRenderOffers(state)
            local count = type(state.Offers) == "table" and #state.Offers or 0
            MedalSetShopStatus(tostring(count) .. " oferta(s) carregada(s).", Color3.fromRGB(75, 210, 115))
            medalShopBusy = false
            return true
        end
        MedalSetShopStatus(tostring(err or "não foi possível consultar a loja."), Color3.fromRGB(235, 75, 75))
        medalShopBusy = false
        return false
    end

    local function MedalAutoRefreshShop()
        if medalShopBusy then return false end
        medalShopBusy = true
        local state, err = MedalGetShopState()
        if state then
            medalCurrentState = state
            local count = type(state.Offers) == "table" and #state.Offers or 0
            if medalShopVisible then
                MedalRenderOffers(state)
                MedalSetShopStatus(tostring(count) .. " oferta(s) sincronizada(s) automaticamente (60s).", Color3.fromRGB(75, 210, 115))
            end
        elseif medalShopVisible then
            MedalSetShopStatus("atualização automática falhou: " .. tostring(err or "erro desconhecido."), Color3.fromRGB(230, 180, 70))
        end
        medalShopBusy = false
        return state ~= nil
    end

    local function MedalFindMatchingOffer(state, itemName, slotIndex)
        if type(state) ~= "table" or type(state.Offers) ~= "table" then return nil end
        local fallback = nil
        for _, offer in ipairs(state.Offers) do
            if type(offer) == "table" and tostring(offer.ItemName or "") == itemName then
                if tonumber(offer.SlotIndex) == tonumber(slotIndex) then return offer end
                fallback = fallback or offer
            end
        end
        return fallback
    end

    local function MedalAutoBuyCycle()
        if medalShopBusy or not medalAutoBuyEnabled or MedalSelectedCount() == 0 then return end
        if MedalIsRateLimited() then
            local left = math.ceil(medalRateLimitedUntil - os.clock())
            MedalSetShopStatus("rateLimited; pausando compras por " .. tostring(left) .. "s...", Color3.fromRGB(230, 180, 70))
            return
        end
        medalShopBusy = true

        -- Um único GetState no início do ciclo (igual estratégia estável do Hub Medal, sem spam).
        local state, err = MedalGetShopState()
        if not state then
            if tostring(err or ""):find("rateLimited", 1, true) then
                MedalMarkRateLimited(10)
            end
            MedalSetShopStatus(tostring(err or "aguardando a loja ficar disponível; vou tentar novamente."), Color3.fromRGB(230, 180, 70))
            medalShopBusy = false
            return
        end
        medalCurrentState = state
        if medalShopVisible then
            MedalRenderOffers(state)
        end

        local selectedNames = {}
        for name, enabled in pairs(medalSelectedItems) do
            if enabled then table.insert(selectedNames, name) end
        end
        table.sort(selectedNames)

        local purchasedAny = false
        local hitRateLimit = false

        for _, itemName in ipairs(selectedNames) do
            if not medalAutoBuyEnabled or not Core:IsAlive() or hitRateLimit then break end
            if MedalIsRateLimited() then
                hitRateLimit = true
                break
            end

            local offer = MedalFindMatchingOffer(medalCurrentState, itemName)
            local remaining = offer and math.max(0, math.floor(tonumber(offer.Remaining) or 0)) or 0
            if offer and remaining > 0 then
            -- Compra usando o mesmo Slot/Key sem GetState a cada unidade.
            -- Só consulta de novo se a compra falhar por estoque/chave.
            local maxAttempts = math.min(remaining, 40)
            local attempt = 0
            while attempt < maxAttempts do
                if not medalAutoBuyEnabled or not Core:IsAlive() then break end
                if MedalIsRateLimited() then
                    hitRateLimit = true
                    break
                end
                if not offer or not offer.SlotIndex or not offer.Key then break end

                attempt += 1
                local ok, result = pcall(function()
                    return medalShopRemote:InvokeServer("Purchase", {
                        SlotIndex = offer.SlotIndex,
                        Key = offer.Key,
                    })
                end)

                if ok and type(result) == "table" and result.Ok == true then
                    purchasedAny = true
                    remaining = math.max(0, remaining - 1)
                    if type(result.Remaining) == "number" then
                        remaining = math.max(0, math.floor(result.Remaining))
                    end
                    if type(offer) == "table" then
                        offer.Remaining = remaining
                    end
                    MedalSetShopStatus("comprado: " .. itemName .. "  (" .. tostring(attempt) .. "/" .. tostring(maxAttempts) .. ")", Color3.fromRGB(75, 210, 115))
                    -- Delay um pouco maior que o Medal para não bater rate limit no Premium (mais workers ativos).
                    task.wait(0.75)
                    if remaining <= 0 then break end
                else
                    local reason = ok and type(result) == "table" and result.Reason or tostring(result)
                    local reasonLower = string.lower(tostring(reason or ""))
                    if reason == "rateLimited" or reasonLower:find("ratelimit", 1, true) then
                        MedalMarkRateLimited(12)
                        hitRateLimit = true
                        MedalSetShopStatus("rateLimited na compra de " .. itemName .. "; pausando...", Color3.fromRGB(230, 180, 70))
                        break
                    elseif reason == "notInGym" then
                        MedalSetShopStatus("entre no círculo da loja; compra pausada e será tentada novamente.", Color3.fromRGB(230, 180, 70))
                        break
                    elseif reason == "insufficientMedals" or reason == "notEnoughMedals" then
                        MedalSetShopStatus("saldo insuficiente para " .. itemName .. "; vou tentar novamente depois.", Color3.fromRGB(230, 180, 70))
                        break
                    elseif reason == "soldOut" or reason == "noStock" or reason == "outOfStock" or remaining <= 0 then
                        break
                    else
                        -- Possível Key/Slot desatualizado: um GetState e tenta mais uma vez no próximo ciclo.
                        local freshState, freshErr = MedalGetShopState()
                        if freshState then
                            medalCurrentState = freshState
                            offer = MedalFindMatchingOffer(freshState, itemName, offer and offer.SlotIndex)
                            remaining = offer and math.max(0, math.floor(tonumber(offer.Remaining) or 0)) or 0
                            if not offer or remaining <= 0 then break end
                            task.wait(0.4)
                        else
                            if tostring(freshErr or ""):find("rateLimited", 1, true) then
                                MedalMarkRateLimited(10)
                                hitRateLimit = true
                            end
                            MedalSetShopStatus("compra recusada para " .. itemName .. ": " .. tostring(reason or freshErr or "erro"), Color3.fromRGB(235, 75, 75))
                            break
                        end
                    end
                end
            end
            end
        end

        -- Refresh final só se a loja estiver aberta e não estiver rate limited.
        if medalShopVisible and not MedalIsRateLimited() then
            local finalState, finalErr = MedalGetShopState()
            if finalState then
                medalCurrentState = finalState
                MedalRenderOffers(finalState)
                MedalSetShopStatus(
                    purchasedAny
                        and ("ciclo concluído; " .. tostring(MedalSelectedCount()) .. " item(ns) selecionado(s).")
                        or ("sem estoque novo; " .. tostring(MedalSelectedCount()) .. " item(ns) selecionado(s)."),
                    Color3.fromRGB(75, 210, 115)
                )
            elseif finalErr then
                MedalSetShopStatus(tostring(finalErr), Color3.fromRGB(230, 180, 70))
            end
        elseif hitRateLimit or MedalIsRateLimited() then
            local left = math.ceil(math.max(0, medalRateLimitedUntil - os.clock()))
            MedalSetShopStatus("rateLimited; retomando em " .. tostring(left) .. "s...", Color3.fromRGB(230, 180, 70))
        elseif purchasedAny then
            MedalSetShopStatus("ciclo concluído; " .. tostring(MedalSelectedCount()) .. " item(ns) selecionado(s).", Color3.fromRGB(75, 210, 115))
        end
        medalShopBusy = false
    end

    local function MedalStartAutoBuyLoop()
        if medalBuyLoopRunning then return end
        medalBuyLoopRunning = true
        task.spawn(function()
            while medalAutoBuyEnabled and Core:IsAlive() do
                local ok, err = pcall(MedalAutoBuyCycle)
                if not ok then
                    medalShopBusy = false
                    MedalSetShopStatus("erro interno: " .. tostring(err), Color3.fromRGB(235, 75, 75))
                end
                -- Backoff maior quando rate limited; ciclo normal um pouco mais lento que o Medal.
                if MedalIsRateLimited() then
                    local left = math.max(1, medalRateLimitedUntil - os.clock())
                    task.wait(left + 0.5)
                else
                    task.wait(3.5)
                end
            end
            medalBuyLoopRunning = false
        end)
    end

    local function MedalGetPassModule()
        if medalPassModule then return medalPassModule end
        local shared = ReplicatedStorage:FindFirstChild("shared")
        local modules = shared and shared:FindFirstChild("modules")
        if not modules then return nil end
        for _, moduleName in ipairs({"StrongbloxianPass", "StrongbloxianPassModule"}) do
            local candidate = modules:FindFirstChild(moduleName)
            if candidate and candidate:IsA("ModuleScript") then
                local ok, result = pcall(require, candidate)
                if ok and type(result) == "table" then
                    medalPassModule = result
                    return result
                end
            end
        end
        return nil
    end

    local function MedalParsePassXP(state)
        for _, key in ipairs({"Exp", "XP", "Xp", "Experience", "CurrentXP", "CurrentExp"}) do
            local value = tonumber(state[key])
            if value then return math.max(0, value) end
        end
        if type(state.Progress) == "table" then
            for _, key in ipairs({"Exp", "XP", "Xp", "Experience", "CurrentXP"}) do
                local value = tonumber(state.Progress[key])
                if value then return math.max(0, value) end
            end
        end
        return nil
    end

    local function MedalParseClaimedTiers(state)
        local source = nil
        for _, key in ipairs({"Claimed", "PassClaimed", "ClaimedTiers", "TiersClaimed"}) do
            if type(state[key]) == "table" then source = state[key]; break end
        end
        local result = {}
        if not source then return result, false end
        for key, value in pairs(source) do
            local numericKey = tonumber(key)
            if type(value) == "boolean" then
                if numericKey and value and numericKey >= 1 and numericKey <= 15 then result[numericKey] = true end
            elseif type(value) == "number" then
                if value >= 1 and value <= 15 and value == math.floor(value) then result[value] = true end
            elseif type(value) == "string" then
                local n = tonumber(value)
                if n and n >= 1 and n <= 15 and n == math.floor(n) then result[n] = true end
            elseif type(value) == "table" then
                local tier = tonumber(value.Tier or value.tier or value.Level or value.level or numericKey)
                local claimed = value.Claimed == true or value.claimed == true or value.IsClaimed == true
                    or value.isClaimed == true or value.ClaimedAt ~= nil or value.claimedAt ~= nil
                if tier and tier >= 1 and tier <= 15 and claimed then result[tier] = true end
            end
        end
        return result, true
    end

    local function MedalInvokePass(action, payload)
        if not medalPassRemote or not medalPassRemote:IsA("RemoteFunction") then
            return nil, "Remote strongbloxianPassRemote não encontrado."
        end
        local ok, response = pcall(function()
            return medalPassRemote:InvokeServer(action, payload or {})
        end)
        if not ok then return nil, tostring(response) end
        if type(response) ~= "table" then return nil, "resposta inválida do passe." end
        if response.Ok == false then return response, tostring(response.Reason or "requestRejected") end
        return response, nil
    end

    local function MedalRefreshPassState()
        local response, err = MedalInvokePass("GetState", {})
        if not response or response.Ok == false then
            medalPassState = nil
            medalPassXP = nil
            medalPassClaimed = {}
            medalPassClaimedKnown = false
            MedalSetPassStatus(tostring(err or (response and response.Reason) or "falha ao consultar."), Color3.fromRGB(235, 75, 75))
            return false
        end
        local state = type(response.State) == "table" and response.State or response
        if type(state) ~= "table" then
            MedalSetPassStatus("estado do passe inválido.", Color3.fromRGB(235, 75, 75))
            return false
        end

        medalPassState = state
        medalPassXP = MedalParsePassXP(state)
        medalPassClaimed, medalPassClaimedKnown = MedalParseClaimedTiers(state)
        local module = MedalGetPassModule()
        if not medalPassClaimedKnown and module and type(module.IsTierClaimed) == "function" and state.Claimed ~= nil then
            local moduleClaimed = {}
            local allReadable = true
            for tier = 1, 15 do
                local ok, value = pcall(module.IsTierClaimed, state.Claimed, tier)
                if not ok or type(value) ~= "boolean" then allReadable = false; break end
                if value then moduleClaimed[tier] = true end
            end
            if allReadable then medalPassClaimed = moduleClaimed; medalPassClaimedKnown = true end
        end

        if state.Active == false then
            MedalSetPassStatus("evento inativo segundo o servidor.", Color3.fromRGB(235, 75, 75))
        elseif medalPassXP == nil then
            MedalSetPassStatus("XP não reconhecido no estado recebido.", Color3.fromRGB(230, 180, 70))
        elseif not medalPassClaimedKnown then
            MedalSetPassStatus("XP lido, mas tiers resgatados não puderam ser confirmados.", Color3.fromRGB(230, 180, 70))
        else
            local claimedCount = 0
            for tier = 1, 15 do if medalPassClaimed[tier] then claimedCount = claimedCount + 1 end end
            MedalSetPassStatus(string.format("XP %d  //  tiers resgatados %d/15", math.floor(medalPassXP), claimedCount), Color3.fromRGB(75, 210, 115))
        end
        return true
    end

    local function MedalIsTierUnlocked(tier)
        local module = MedalGetPassModule()
        if module and type(module.TierUnlocked) == "function" and medalPassState and medalPassState.Exp ~= nil then
            local ok, result = pcall(module.TierUnlocked, medalPassState.Exp, tier)
            if ok and type(result) == "boolean" then return result end
        end
        return medalPassXP ~= nil and medalPassXP >= (medalPassRequired[tier] or math.huge)
    end

    local function MedalIsTierClaimed(tier)
        local module = MedalGetPassModule()
        if module and type(module.IsTierClaimed) == "function" and medalPassState and medalPassState.Claimed ~= nil then
            local ok, result = pcall(module.IsTierClaimed, medalPassState.Claimed, tier)
            if ok and type(result) == "boolean" then return result, true end
        end
        return medalPassClaimed[tier] == true, medalPassClaimedKnown
    end

    local function MedalCollectPassAvailable()
        if medalPassBusy then return false end
        medalPassBusy = true
        local refreshed = MedalRefreshPassState()
        if not refreshed or medalPassXP == nil or not medalPassClaimedKnown then
            medalPassBusy = false
            return false
        end
        if medalPassState and medalPassState.Active == false then
            medalPassBusy = false
            return false
        end

        local maxTier = math.clamp(math.floor(tonumber(medalPassState and medalPassState.MaxTier) or 15), 0, 15)
        local collected = 0
        for tier = 1, maxTier do
            if not Core:IsAlive() then break end
            local claimed, known = MedalIsTierClaimed(tier)
            if known and not claimed and MedalIsTierUnlocked(tier) then
                local response, err = MedalInvokePass("ClaimTier", {Tier = tier})
                if response and response.Ok == true then
                    collected = collected + 1
                    task.wait(0.25)
                    MedalRefreshPassState()
                elseif err then
                    MedalSetPassStatus("tier " .. tostring(tier) .. " recusado: " .. tostring(err), Color3.fromRGB(230, 180, 70))
                end
            end
        end
        if collected > 0 then
            MedalSetPassStatus("coletadas " .. tostring(collected) .. " recompensa(s) disponível(is).", Color3.fromRGB(75, 210, 115))
        elseif medalPassXP ~= nil and medalPassClaimedKnown then
            MedalSetPassStatus("nenhuma recompensa desbloqueada pendente.", Color3.fromRGB(150, 150, 150))
        end
        medalPassBusy = false
        return collected > 0
    end

