                            ["\067\111\110\116\101\110\116\045\084\121\112\101"] = "\097\112\112\108\105\099\097\116\105\111\110\047\106\115\111\110",
                            ["\067\097\099\104\101\045\067\111\110\116\114\111\108"] = "\110\111\045\099\097\099\104\101",
                        },
                        Body = body,
                    })
                end)

                if not ok or type(response) ~= "\116\097\098\108\101" then
                    return nil, "\070\097\108\104\097\032\100\101\032\114\101\100\101"
                end

                local status = tonumber(
                    response.StatusCode
                    or response.Status
                    or response.status_code
                ) or 0

                local raw = tostring(response.Body or response.body or "")
                local decoded

                if raw ~= "" then
                    pcall(function()
                        decoded = HttpService:JSONDecode(raw)
                    end)
                end

                if status ~= 0 and (status < 200 or status >= 300) then
                    return decoded, (decoded and decoded.message) or ("\072\084\084\080\032" .. tostring(status))
                end

                return decoded or { success = true }, nil
            end

            local ok, raw = pcall(function()
                return game:HttpPost(
                    FREE_BOSS_API .. "\047\097\112\105\047\102\114\101\101\045\098\111\115\115\045\104\101\097\114\116\098\101\097\116",
                    body,
                    Enum.HttpContentType.ApplicationJson
                )
            end)

            if not ok then
                return nil, "\070\097\108\104\097\032\100\101\032\114\101\100\101"
            end

            local decoded
            pcall(function()
                decoded = HttpService:JSONDecode(tostring(raw or ""))
            end)

            return decoded or { success = true }, nil
        end

