                        state.lastAttempt = 0
                    end

                    local sinceHeartbeat = now - (state.lastHeartbeat or 0)
                    local sinceAttempt = now - (state.lastAttempt or 0)

                    if not state.sending then
                        if state.lastHeartbeat <= 0 then
