                formatted = formatted:sub(2)
            end
            return formatted
        end
        local function getActiveBossDamageFolder()
            local events = workspace:FindFirstChild("Events")
            local arena = events and events:FindFirstChild("BossArena")
            if not arena then return nil, nil end
            for _, bossName in ipairs(DAMAGE_BOSS_NAMES) do
                local boss = arena:FindFirstChild(bossName)
                if boss then
                    local damageValues = boss:FindFirstChild("damageValues")
                    if damageValues then
                        return boss, damageValues
                    end
                end
            end
            return nil, nil
        end
        local function readBossDamage()
            local boss, damageValues = getActiveBossDamageFolder()
            if not boss or not damageValues then
                return nil
            end
            for _, key in ipairs({
                player.Name,
                player.DisplayName,
                tostring(player.UserId)
            }) do
                local valueObj = damageValues:FindFirstChild(key)
                if valueObj and (valueObj:IsA("NumberValue") or valueObj:IsA("IntValue")) then
                    return tonumber(valueObj.Value) or 0
                end
            end
            local numericValues = {}
            for _, obj in ipairs(damageValues:GetChildren()) do
                if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                    table.insert(numericValues, obj)
                end
            end
            if #numericValues == 1 then
                return tonumber(numericValues[1].Value) or 0
            end
            if #numericValues > 1 then
                local total = 0
                for _, obj in ipairs(numericValues) do
                    total += tonumber(obj.Value) or 0
                end
                return total
            end
            return 0
        end
        local function refreshBossDamageBadge()
            local bossAliveForAutoFarm =
                BossDamageHudState.AutoBossEnabled == true
                and BossDamageHudState.BossAlive == true
            damageBadge.Visible = bossAliveForAutoFarm
            if not bossAliveForAutoFarm then
                return
            end
            local damage = readBossDamage()
            if damage == nil then
                damageText.Text = "DANO BOSS: --"
            else
                damageText.Text = "DANO BOSS: " .. formatBossDamage(damage)
            end
        end
        Core:StartWorker("UI.LicenseBadge", function(isAlive)
            while isAlive() and licenseGui.Parent do
                if not Core:GetConfig("memPauseHud", false) then
                    pcall(refreshBossDamageBadge)
                end
                task.wait(0.10)
            end
        end)
        refreshBossDamageBadge()
        task.defer(clampMainWindow)
    end
    function SystemUIModule:Stop()
        Core:StopWorker("UI.LicenseBadge")
        if self.HudGui then
            pcall(function() self.HudGui:Destroy() end)
            self.HudGui = nil
        end
        Core:CleanupOwner("SystemUI")
    end
    if Core then
        Core:RegisterModule("SystemUI", SystemUIModule)
        local okSystem, errSystem = Core:StartModule("SystemUI")
        if not okSystem then
            warn("[ARASAKA][MODULE:SystemUI] Falha:", errSystem)
