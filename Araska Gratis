        local function freeBossIsAlive(obj)
            if not obj or not obj.Parent then
                return false
            end

            if obj:IsA("\077\111\100\101\108") then
                local humanoid = obj:FindFirstChildOfClass("\072\117\109\097\110\111\105\100")
                if humanoid then
                    return humanoid.Health > 0
                end

                return obj.PrimaryPart ~= nil
                    or obj:FindFirstChild("\072\117\109\097\110\111\105\100\082\111\111\116\080\097\114\116") ~= nil
                    or obj:FindFirstChild("\072\101\097\100") ~= nil
                    or obj:FindFirstChildWhichIsA("\066\097\115\101\080\097\114\116") ~= nil
            end

            return obj:IsA("\066\097\115\101\080\097\114\116")
        end

