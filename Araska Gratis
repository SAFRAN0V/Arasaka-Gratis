                    if not ok then
                        medalShopBusy = false
                        if medalShopVisible then
                            MedalSetShopStatus("erro na atualização automática: " .. tostring(err), Color3.fromRGB(235, 75, 75))
                        end
                    end
                end
            end
        end
    end)
end

