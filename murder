local function stop()
    Running = false
    Settings.Aim = false
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    for p in pairs(Highlights) do clearPlayer(p) end
    if Gui.Parent then Gui:Destroy() end
end
Env.ARASAKA_MM2_STOP = stop
StopButton.MouseButton1Click:Connect(stop)

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.F1 then
        Settings.Aim = false
        for _, node in ipairs(Frame:GetDescendants()) do
            if node:IsA("TextButton") and node.Text == "ON" then
                local p = node.Parent
                local label = p and p:FindFirstChildOfClass("TextLabel")
                if label and label.Text == "Aim Lock (F1)" then
                    node.Text = "OFF"
                    node.BackgroundColor3 = Color3.fromRGB(92,45,54)
                end
            end
        end
        Target = nil
    end
end))

