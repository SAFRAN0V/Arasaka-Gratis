local accumulator = 0
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if not Running then return end
    accumulator += dt
    if accumulator >= 0.18 then
        accumulator = 0
        for _, p in ipairs(Players:GetPlayers()) do makeESP(p) end
        local own = roundInfo(LocalPlayer) or "Aguardando"
        local targetRole = own == "Murderer" and "Sheriff/Hero" or "Murderer"
        Status.Text = "Seu papel: " .. tostring(own) .. " | Alvo: " .. targetRole .. "\nF1: desliga Aim Lock | Mira somente com alvo visivel na tela"
    end
    if Settings.Aim and isAlive(LocalPlayer) then
        Target = getTarget()
        if Target and Target.Character then
            local head = Target.Character:FindFirstChild("Head")
            if head then
                local desired = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(Settings.Smoothness, 0.05, 1))
            end
        end
    else
        Target = nil
    end
end))

