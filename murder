local function roundInfo(p)
    local data = CurrentRoundClient.PlayerData
    local info = type(data) == "table" and data[p.Name]
    if type(info) ~= "table" then return nil, false end
    return info.Role, info.Dead == true
end

local function isAlive(p)
    local ch = p.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local role, dead = roundInfo(p)
    return ch and hum and hum.Health > 0 and not dead and role ~= nil
end

local function clearPlayer(p)
    if Highlights[p] then Highlights[p]:Destroy() Highlights[p] = nil end
    if Billboards[p] then Billboards[p]:Destroy() Billboards[p] = nil end
    if Tracers[p] then Tracers[p]:Destroy() Tracers[p] = nil end
end

local function makeESP(p)
    if p == LocalPlayer then return end
    local role = roundInfo(p)
    local ch = p.Character
    local head = ch and ch:FindFirstChild("Head")
    if not Settings.ESP or not isAlive(p) or not RoleColors[role] or not ch or not head then
        clearPlayer(p)
        return
    end
    local color = RoleColors[role]
    local h = Highlights[p]
    if not h or h.Parent ~= ch then
        clearPlayer(p)
        h = Instance.new("Highlight")
        h.Name = "ArasakaRoleHighlight"
        h.Adornee = ch
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency = 0.5
        h.OutlineTransparency = 0
        h.Parent = ch
        Highlights[p] = h
    end
    h.FillColor = color
    h.OutlineColor = color
    local b = Billboards[p]
    if Settings.Names then
        if not b or b.Adornee ~= head then
            if b then b:Destroy() end
            b = Instance.new("BillboardGui")
            b.Name = "ArasakaRoleLabel"
            b.Size = UDim2.fromOffset(160, 34)
            b.StudsOffset = Vector3.new(0, 2.65, 0)
            b.AlwaysOnTop = true
            b.Adornee = head
            b.Parent = Gui
            local txt = Instance.new("TextLabel")
            txt.Name = "Label"
            txt.Size = UDim2.fromScale(1, 1)
            txt.BackgroundTransparency = 1
            txt.TextScaled = true
            txt.Font = Enum.Font.GothamBold
            txt.TextStrokeTransparency = 0.25
            txt.Parent = b
            Billboards[p] = b
        end
        b.Label.Text = p.DisplayName .. " | " .. role
        b.Label.TextColor3 = color
        b.Enabled = true
    elseif b then
        b:Destroy()
        Billboards[p] = nil
    end
end

local function getTarget()
    local ownRole = roundInfo(LocalPlayer)
    local wanted
    if ownRole == "Sheriff" or ownRole == "Hero" then
        wanted = { Murderer = true }
    elseif ownRole == "Murderer" then
        wanted = { Sheriff = true }
        if Settings.HeroTarget then wanted.Hero = true end
    else
        return nil
    end
    local best, bestDistance = nil, math.huge
    local center = Camera.ViewportSize / 2
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then
            local role = roundInfo(p)
            local ch = p.Character
            local head = ch and ch:FindFirstChild("Head")
            if wanted[role] and head then
                local distance = (head.Position - Camera.CFrame.Position).Magnitude
                if distance <= Settings.MaxDistance then
                    local pos, visible = Camera:WorldToViewportPoint(head.Position)
                    if visible and pos.Z > 0 then
                        local diff = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if diff < bestDistance then
                            bestDistance = diff
                            best = p
                        end
                    end
                end
            end
        end
    end
    return best
end

