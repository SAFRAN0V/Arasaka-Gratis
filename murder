local moveStart, origin, moving, dragged, moved
local function draggable(widget, target, restoreOnClick)
    widget.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            moving = input
            moveStart = input.Position
            origin = target.Position
            moved = false
        end
    end)
    widget.InputEnded:Connect(function(input)
        if input == moving then
            moving = nil
            if restoreOnClick and not moved then toggleMini() end
        end
    end)
    table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
        if not moving then return end
        if moving.UserInputType == Enum.UserInputType.Touch then
            if input ~= moving then return end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - moveStart
        if delta.Magnitude > 7 then moved = true end
        if not moved then return end
        target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X, origin.Y.Scale, origin.Y.Offset + delta.Y)
    end))
end

